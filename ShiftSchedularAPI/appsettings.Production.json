{
  "ConnectionStrings": {
    "DefaultConnection": "AZURE_CONN_STRING_PLACEHOLDER"
  },
  "LogDirectory": "AZURE_LOG_DIRECTORY_PLACEHOLDER",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "EmailSettings": {
    "SmtpServer": "smtp.example.com",
    "Port": 587,
    "SenderEmail": "noreply@example.com",
    "SenderUser": "AZURE_EMAIL_SENDER_USER_PLACEHOLDER",
    "SenderPassword": "AZURE_EMAIL_SENDER_PASS_PLACEHOLDER"
  },
  "Jwt": {
    "Issuer": "AZURE_JWT_ISSUER_PLACEHOLDER",
    "Audience": "AZURE_JWT_AUDIENCE_PLACEHOLDER",
    "Key": "AZURE_JWT_KEY_PLACEHOLDER",
    "TokenValidityInMinutes": 60,
    "RefreshTokenValidityInMinutes": 60
  },
  "AllowedHosts": "*"
}