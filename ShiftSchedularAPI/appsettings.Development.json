{
  "BaseUrl": "https://localhost:4200/",
  "ConnectionStrings": {
    "DefaultConnection": "CONN_STRING_PLACEHOLDER"
  },
  "LogDirectory": "LOG_DIRECTORY_PLACEHOLDER",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.EntityFrameworkCore": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext} {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/dev-log-.txt",
          "rollingInterval": "Day",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] [{SourceContext}] [{ThreadId}] {Message:lj} {Properties:j}{NewLine}{Exception}",
          "retainedFileCountLimit": 7
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId", "WithEnvironmentName" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "EmailSettings": {
    "SmtpServer": "SMTP_SERVER_PLACEHOLDER",
    "Port": 587,
    "SenderEmail": "SMTP_SENDER_EMAIL_PLACEHOLDER",
    "SenderUser": "SMTP_SENDER_USER_PLACEHOLDER",
    "SenderPassword": "SMTP_SENDER_PASSWORD_PLACEHOLDER"
  },
  "Jwt": {
    "Issuer": "JWT_ISSUER_PLACEHOLDER",
    "Audience": "JWT_AUDIENCE_PLACEHOLDER",
    "Key": "JWT_KEY_PLACEHOLDER",
    "TokenValidityInMinutes": 30,
    "RefreshTokenValidityInMinutes": 60
  },
  "AllowedOrigins": [
    "http://localhost:4200"
  ]
}
