{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "LogDirectory": "",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] [{SourceContext}] {Message:lj} {Properties:j}{NewLine}{Exception}",
          "retainedFileCountLimit": 30
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId", "WithEnvironmentName" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Culture": {
    "Default": "en-US",
    "Supported": [ "en-US" ]
  },
  "RateLimitSettings": {
    "Login": {
      "PermitLimit": 5,
      "WindowMinutes": 1
    },
    "Registration": {
      "TokenLimit": 10,
      "ReplenishmentHours": 1
    },
    "ForgotPassword": {
      "PermitLimit": 3,
      "WindowMinutes": 15
    },
    "Api": {
      "AuthenticatedLimit": 100,
      "AnonymousLimit": 20,
      "WindowMinutes": 1
    }
  },
  "FrontendUrl": "http://localhost:4200",
  "EmailSettings": {
    "SmtpServer": "",
    "Port": 587,
    "SenderEmail": "",
    "SenderUser": "",
    "SenderPassword": ""
  },
  "Jwt": {
    "Issuer": "",
    "Audience": "",
    "Key": "",
    "TokenValidityInMinutes": 30,
    "RefreshTokenValidityInMinutes": 60
  },
  "AllowedOrigins": [
    "http://localhost:4200"
  ]
}
