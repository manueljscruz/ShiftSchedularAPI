{
  "ConnectionStrings": {
    "DefaultConnection": ""
    },
  "LogDirectory": "",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Culture": {
    "Default": "en-US",
    "Supported": [ "en-US" ]
  },
  "RateLimitSettings": {
    "Login": {
      "PermitLimit": 5,
      "WindowMinutes": 1
    },
    "Registration": {
      "TokenLimit": 10,
      "ReplenishmentHours": 1
    },
    "Api": {
      "AuthenticatedLimit": 100,
      "AnonymousLimit": 20,
      "WindowMinutes": 1
    }
  },
  "EmailSettings": {
    "SmtpServer": "",
    "Port": 587,
    "SenderEmail": "",
    "SenderUser": "",
    "SenderPassword": ""
  },
  "Jwt": {
    "Issuer": "",
    "Audience": "",
    "Key": "",
    "TokenValidityInMinutes": 30,
    "RefreshTokenValidityInMinutes": 60
  },
  "AllowedOrigins": [
    "http://localhost:4200"
  ]
}
